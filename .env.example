# Copy this file to .env and fill in the values.
# The real .env is git-ignored; never commit it.

# Your Weights & Biases API key (from https://wandb.ai/authorize)
WANDB_API_KEY=

# W&B project that all runs are logged to
WANDB_PROJECT=genai-a1

# Your W&B username or team name (leave empty to use the account default)
WANDB_ENTITY=

# online = upload runs, offline = log locally and sync later, disabled = no logging
WANDB_MODE=online
